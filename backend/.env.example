# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3001
# development or production. In production the cookie is HTTPS-only and SESSION_SECRET is required.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=hms_user
DB_PASSWORD=change-me
DB_NAME=hms
# Long random string used to sign login cookies
# (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string
# Where the React app runs (allowed by CORS and the CSRF check, and used in reset links)
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 when the app runs behind one reverse proxy (nginx, Render, Heroku, ...)
TRUST_PROXY=
# If set, doctors must enter this code to register. Leave empty to allow open doctor sign-up.
DOCTOR_INVITE_CODE=
# Multiplies the sign-in, sign-up and password-reset rate limits (1 = 5 failed sign-ins per 15 minutes)
RATE_LIMIT_SCALE=1

# Email for password reset links. Without SMTP_HOST, development prints the email
# in the backend terminal instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HMS Hospital <no-reply@localhost>
