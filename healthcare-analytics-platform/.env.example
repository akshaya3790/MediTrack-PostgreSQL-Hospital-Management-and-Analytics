# Copy this file to .env and fill in the values. Never commit .env.

# Database the pipeline reads from and writes the analytics schemas into.
# Normally the hospital database itself; use hms_synthetic_dev for the synthetic demo.
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=hms
ANALYTICS_DB_USER=hms_analytics
ANALYTICS_DB_PASSWORD=

# Secret used to turn patient and doctor emails into pseudonymous keys (HMAC-SHA256).
# Make it long and random, and keep it: changing it makes every patient look new.
ANALYTICS_PSEUDONYM_KEY=

# Must be the same value as SESSION_SECRET in backend/.env, so the dashboard can recognise
# an administrator who is signed in to the hospital app. Leave empty if the backend has none.
HMS_SESSION_SECRET=

# Where the hospital app runs (used for the "sign in" link on the dashboard)
HMS_APP_URL=http://localhost:3000

# Analytics dashboard and API
ANALYTICS_PORT=3002

# Pipeline settings
PIPELINE_MAX_RETRIES=2
PIPELINE_RETRY_DELAY_MS=5000
PIPELINE_FRESHNESS_HOURS=26
PIPELINE_SCHEDULE_MINUTES=60
CAPACITY_DAYS_AHEAD=28
