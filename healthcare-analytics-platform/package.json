{
  "name": "hms-healthcare-analytics-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Separate analytics platform for the Hospital Management System: pipeline, warehouse, data quality, dashboard and ML",
  "author": "akshaya",
  "scripts": {
    "db:init": "node src/tools/init-db.js",
    "pipeline": "node src/pipeline/run.js",
    "pipeline:incremental": "node src/pipeline/run.js --mode=incremental",
    "validate": "node src/pipeline/run.js --validate-only",
    "refresh": "node src/pipeline/run.js --refresh-only",
    "schedule": "node src/pipeline/scheduler.js",
    "profile": "node src/tools/profile.js",
    "synthetic": "node src/tools/synthetic.js",
    "sql:check": "node src/tools/sql-check.js",
    "verify:baseline": "node src/tools/verify-baseline.js",
    "start": "node src/server/server.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/pipeline.test.js test/api.test.js test/regression.test.js",
    "test:ml": "python -m pytest -q ml/tests",
    "ml:train": "python ml/train.py",
    "docs:generate": "node src/tools/generate-docs.js"
  },
  "dependencies": {
    "cookie-signature": "^1.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=18"
  }
}
